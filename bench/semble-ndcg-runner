#!/usr/bin/env python3
"""Score `codesage search` on semble's published annotation corpus, NDCG@10.

This uses semble's annotations and binary-relevance NDCG formula, but deduplicates
results by file and weights language means by query count. Upstream rankings can
retain chunks and its language means weight repositories equally. These scores
are not directly comparable to upstream's published table.

Scope: semble's corpus spans 19 languages; CodeSage parses 9. Running the
unsupported 10 would score ~0 and drag a pooled average into meaninglessness,
so this reports PER LANGUAGE over the supported subset and never quotes a
single "overall" number against semble's 63-repo overall.

The dcg, ndcg_at_k, path_matches, and file_rank helpers come from semble's
benchmarks/metrics.py and data.py. File deduplication and aggregation are local.

Usage:
  semble-ndcg-runner --corpus ~/.cache/semble-bench \
      --annotations ~/ai/codesage_ref/semble/benchmarks/annotations \
      --repos ~/ai/codesage_ref/semble/benchmarks/repos.json \
      --codesage-bin /abs/path/to/target/release/codesage \
      [--limit 10] [--json out.json]

`--codesage-bin` must be ABSOLUTE: each search runs with cwd set to the corpus
repo, so a relative path resolves against that repo and dies with FileNotFound.
"""
import argparse
import hashlib
import json
import math
import os
import subprocess
import sys
from collections import Counter, defaultdict
from pathlib import Path

sys.path.append(str(Path(__file__).resolve().parent))
from _codesage_version import codesage_version_info  # noqa: E402


def codesage_provenance(codesage_bin: str) -> dict:
    """Binary provenance from the first `--version` line plus build fields.

    The banner's `device configured` line depends on the cwd's project config
    and this runner searches many repos, so it is deliberately not recorded.
    """
    info = codesage_version_info(codesage_bin)
    return {
        "codesage_version": None if info["version"] == "unknown" else info["version"],
        "codesage_build_target": info.get("build_target"),
        "codesage_features": info.get("features"),
    }

SUPPORTED = {
    "python", "php", "c", "cpp", "java",
    "rust", "javascript", "typescript", "go",
}

SEARCH_LOG_FILTER = "warn,codesage=info"
QUALITY_WARNINGS = {
    "rerank-failed": "cross-encoder rerank failed; keeping pre-rerank order",
    "daemon-rerank-failed": "daemon reranking failed",
    "cpu-fallback": "CODESAGE_ALLOW_CPU_FALLBACK: CUDA was requested but its libraries are not",
}
TRANSPORT_FALLBACKS = {
    "rerank-byte-cap": "reranker input exceeds daemon byte caps; reranking privately",
    "embed-connect": "daemon cannot embed for this run; embedding privately",
    "embed-private": "; embedding these privately",
}


# --- semble benchmarks/metrics.py, verbatim ---------------------------------
def dcg(relevances):
    return sum(rel / math.log2(i + 2) for i, rel in enumerate(relevances))


def ndcg_at_k(relevant_ranks, n_relevant, k):
    if n_relevant == 0:
        return 0.0
    relevances = [0] * k
    for rank in relevant_ranks:
        if 1 <= rank <= k:
            relevances[rank - 1] = 1
    ideal = dcg([1] * min(k, n_relevant))
    return dcg(relevances) / ideal if ideal > 0 else 0.0


# --- semble benchmarks/data.py, verbatim ------------------------------------
def path_matches(file_path, target_path):
    norm_file = file_path.replace("\\", "/")
    norm_target = target_path.replace("\\", "/")
    return (
        norm_file == norm_target
        or norm_file.endswith(f"/{norm_target}")
        or norm_target.endswith(f"/{norm_file}")
    )


def file_rank(file_paths, target_path):
    for i, fp in enumerate(file_paths, 1):
        if path_matches(fp, target_path):
            return i
    return None


def target_path(entry):
    """Annotation targets are paths, optionally carrying a `:start-end` span."""
    if isinstance(entry, dict):
        entry = entry.get("path", "")
    return str(entry).split(":", 1)[0]


def search(binary, repo_dir, query, limit, timeout=120):
    """Return (file paths, status, diagnostics), retaining usable degraded results.

    Preserve usable results after teardown failures or timeouts, but mark the
    run degraded. Treating them as clean misses would distort retrieval scores.
    """
    timed_out = False
    try:
        proc = subprocess.run(
            [binary, "search", "--json", "--limit", str(limit), query],
            cwd=repo_dir, capture_output=True, text=True, timeout=timeout,
            env={**os.environ, "RUST_LOG": SEARCH_LOG_FILTER},
        )
        stdout, stderr, returncode = proc.stdout, proc.stderr, proc.returncode
    except subprocess.TimeoutExpired as exc:
        timed_out = True
        stdout = exc.stdout or ""
        if isinstance(stdout, bytes):
            stdout = stdout.decode("utf-8", "replace")
        stderr = exc.stderr or ""
        if isinstance(stderr, bytes):
            stderr = stderr.decode("utf-8", "replace")
        returncode = None

    evidence = {
        "returncode": returncode,
        "timed_out": timed_out,
        "stderr": stderr,
        "quality_degradation": [code for code, marker in QUALITY_WARNINGS.items()
                                if marker in stderr],
        "transport_fallbacks": [code for code, marker in TRANSPORT_FALLBACKS.items()
                                if marker in stderr],
    }

    try:
        data = json.loads(stdout)
    except json.JSONDecodeError:
        if timed_out:
            return [], "timeout", evidence
        return [], "crashed" if returncode != 0 else "unparseable", evidence

    # Valid JSON without a result list is a failure, not a retrieval miss.
    if isinstance(data, dict):
        if "results" not in data:
            return [], "invalid-output", evidence
        rows = data["results"]
    else:
        rows = data
    if not isinstance(rows, list):
        return [], "invalid-output", evidence

    seen = {}
    for r in rows:
        if not isinstance(r, dict):
            return [], "invalid-output", evidence
        fp = r.get("file_path")
        if fp:
            seen.setdefault(fp, None)

    if timed_out:
        status = "timeout-with-output"
    elif returncode != 0:
        status = "crashed-with-output"
    elif evidence["quality_degradation"]:
        status = "degraded"
    elif evidence["transport_fallbacks"]:
        status = "transport-fallback"
    else:
        status = "ok"
    return list(seen)[:limit], status, evidence


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--corpus", required=True, type=Path)
    ap.add_argument("--annotations", required=True, type=Path)
    ap.add_argument("--repos", required=True, type=Path)
    ap.add_argument("--codesage-bin", required=True)
    ap.add_argument("--limit", type=int, default=10)
    ap.add_argument("--json", type=Path)
    ap.add_argument("--only", nargs="*", help="restrict to these repo names")
    args = ap.parse_args()

    # Resolve before subprocesses change cwd to each corpus repository.
    bin_path = Path(args.codesage_bin)
    if not bin_path.is_absolute():
        bin_path = bin_path.resolve()
    if not bin_path.exists():
        sys.exit(f"codesage binary not found: {bin_path}")
    args.codesage_bin = str(bin_path)

    specs = [r for r in json.loads(args.repos.read_text()) if r["language"] in SUPPORTED]
    if args.only:
        specs = [r for r in specs if r["name"] in args.only]

    per_repo, by_lang, skipped = {}, defaultdict(list), []
    run_warnings = []
    for spec in specs:
        name, lang = spec["name"], spec["language"]
        # Match semble's search scope; whole-repo distractors change the task.
        root = spec.get("benchmark_root")
        repo_dir = args.corpus / name / root if root else args.corpus / name
        ann = args.annotations / f"{name}.json"
        if not repo_dir.exists() or not ann.exists():
            skipped.append(f"{name} (missing checkout or annotations)")
            continue
        db = repo_dir / ".codesage" / "index.db"
        if not db.exists():
            skipped.append(f"{name} (not indexed)")
            continue
        # An empty semantic index is not evidence of poor retrieval.
        try:
            import sqlite3

            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
            n_sem = con.execute("SELECT count(*) FROM semantic_files").fetchone()[0]
            con.close()
        except Exception as exc:  # noqa: BLE001 - report, never score
            skipped.append(f"{name} (index unreadable: {exc})")
            continue
        if n_sem == 0:
            skipped.append(f"{name} (semantic index empty - not scored)")
            continue

        tasks = json.loads(ann.read_text())
        scores = []
        statuses = Counter()
        query_results = []
        for query_index, t in enumerate(tasks):
            targets = [target_path(x) for x in
                       (t.get("relevant", []) + t.get("secondary", []))]
            got, status, evidence = search(args.codesage_bin, repo_dir, t["query"], args.limit)
            statuses[status] += 1
            ranks = [r for tp in targets if (r := file_rank(got, tp)) is not None]
            score = ndcg_at_k(ranks, len(targets), args.limit)
            scores.append(score)
            query_results.append({
                "query_index": query_index, "query": t["query"], "status": status,
                "paths": got, "ndcg@10": score, **evidence,
            })
        mean = sum(scores) / len(scores) if scores else 0.0
        degraded = {k: v for k, v in statuses.items() if k != "ok"}
        per_repo[name] = {
            "language": lang, "queries": len(scores), "ndcg@10": round(mean, 4),
            "query_results": query_results,
        }
        if degraded:
            per_repo[name]["degraded"] = dict(degraded)
            for k, v in degraded.items():
                run_warnings.append(f"{name}: {v} query(s) {k}")
        by_lang[lang].append((mean, len(scores), dict(degraded)))
        flag = f"  [{', '.join(f'{v} {k}' for k, v in degraded.items())}]" if degraded else ""
        print(f"  {name:<22} {lang:<11} n={len(scores):<4} ndcg@10={mean:.3f}{flag}",
              file=sys.stderr)

    lang_tbl = {}
    for lang, rows in sorted(by_lang.items()):
        n = sum(c for _, c, _ in rows)
        entry = {
            "repos": len(rows),
            "queries": n,
            "ndcg@10": round(sum(m * c for m, c, _ in rows) / n, 4) if n else 0.0,
        }
        # Published per-language rows must retain query failure disclosures.
        lang_degraded = Counter()
        for _, _, d in rows:
            lang_degraded.update(d)
        if lang_degraded:
            entry["degraded"] = dict(lang_degraded)
        lang_tbl[lang] = entry

    def _rev(path):
        try:
            r = subprocess.run(["git", "-C", str(path), "rev-parse", "HEAD"],
                               capture_output=True, text=True, timeout=10)
            return r.stdout.strip() or None
        except Exception:  # noqa: BLE001 - provenance is best-effort, never fatal
            return None

    provenance = {
        **codesage_provenance(args.codesage_bin),
        "codesage_commit": _rev(Path(__file__).resolve().parent.parent),
        "semble_commit": _rev(args.repos.parent.parent),
        "corpus_root": str(args.corpus),
        "limit": args.limit,
        "runner_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "search_log_filter": SEARCH_LOG_FILTER,
        "diagnostic_policy": {
            "quality_warnings": QUALITY_WARNINGS,
            "transport_fallbacks": TRANSPORT_FALLBACKS,
            "other_stderr": "retained without changing status",
        },
        "scoring": {"ranking_unit": "deduplicated file", "language_weighting": "query count"},
    }

    out = {
        "provenance": provenance,
        "per_repo": per_repo,
        "by_language": lang_tbl,
        "skipped": skipped,
        "warnings": run_warnings,
        "note": "supported-language subset of semble's corpus; no pooled overall is "
                "reported because the unsupported 10 languages are not run",
    }
    print(json.dumps(out, indent=2))
    if args.json:
        args.json.write_text(json.dumps(out, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
