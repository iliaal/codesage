# Missing tiktoken disables token metrics, not retrieval scoring.
try:
    import tiktoken
    _ENCODING = tiktoken.get_encoding("cl100k_base")
    def _count_tokens(text: str) -> int:
        encoding = _ENCODING
        return len(encoding.encode(text or "")) if encoding is not None else 0
except ImportError:
    _ENCODING = None
    def _count_tokens(_text: str) -> int:
        return 0


# Misses charge a fixed budget: Semble uses 32k. Sets a ceiling so a
# pathological miss rate doesn't make the average meaningless.
_MISS_TOKEN_PENALTY = 32_000


def _run(cmd: list[str], cwd: Path | None = None) -> str:
    try:
        r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=30,
                           env=git_environment() if cmd[0] == "git" else None)
        if r.returncode == 0:
            return r.stdout.strip()
    except (subprocess.SubprocessError, FileNotFoundError):
        pass
    return ""


def project_head_sha(project_root: Path) -> str:
    sha = _run(["git", "rev-parse", "--short=12", "HEAD"], cwd=project_root)
    return sha or "not-a-git-repo"


def project_size(project_root: Path) -> tuple[int, int]:
    """Count tracked source files and lines; return (0, 0) without Git output."""
    files = _run(["git", "ls-files"], cwd=project_root)
    if not files:
        return 0, 0
    extensions = {
        ".rs", ".py", ".ts", ".tsx", ".js", ".jsx",
        ".c", ".h", ".cpp", ".hpp", ".cc", ".cxx",
        ".php", ".go", ".rb", ".java", ".kt", ".swift",
        ".scala", ".cs",
    }
    paths = [
        project_root / p
        for p in files.splitlines()
        if Path(p).suffix in extensions
    ]
    file_count = 0
    line_count = 0
    for p in paths:
        try:
            if not p.is_file():
                continue
            with p.open("rb") as f:
                line_count += sum(1 for _ in f)
            file_count += 1
        except OSError:
            continue
    return file_count, line_count


def codesage_config(project_root: Path) -> dict:
    """Parse `.codesage/config.toml` for embedding model / reranker / device."""
    cfg = project_root / ".codesage" / "config.toml"
    if not cfg.is_file():
        return {}
    try:
        return tomllib.loads(cfg.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def now_iso_utc() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run_codesage_search(
    codesage_bin: str, project_root: Path, query: str, limit: int
) -> tuple[str, str | None, dict]:
    """Return (stdout, error, runtime). `error` is None on a clean run, else
    `"timeout"`, `"rc=N"`, or `"error"`; the case is still scored (as a miss
    when stdout is empty) so one bad search does not discard the run, but the
    failure is recorded so compare-runs can refuse to read lift into it."""
    codesage_bin = absolute_executable(codesage_bin)
    cmd = [codesage_bin, "search", "--json", "--limit", str(limit), query]
    runtime = {**QUERY_RUNTIME, "command": cmd}
    with tempfile.TemporaryDirectory(prefix="codesage-bench-query-") as directory:
        runtime_path = Path(directory)
        runtime.update(runtime_dir=directory, directory_mode=runtime_path.stat().st_mode & 0o777,
                       entries_before=sorted(p.name for p in runtime_path.iterdir()),
                       reranker=codesage_config(project_root).get("embedding", {}).get("reranker", "none"))
        try:
            child = subprocess.Popen(
                cmd, cwd=project_root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                env={**os.environ, "RUST_LOG": QUERY_LOG_FILTER, "NO_COLOR": QUERY_NO_COLOR,
                     "CODESAGE_DAEMON_RUNTIME_DIR": directory},
            )
            runtime["pid"] = child.pid
            try:
                stdout, stderr = child.communicate(timeout=120)
            except subprocess.TimeoutExpired:
                child.kill()
                stdout, stderr = child.communicate()
                runtime.update(stderr=stderr, stderr_sha256=hashlib.sha256(stderr.encode()).hexdigest())
                print(f"[warn] codesage search timed out after 120s: {query!r}", file=sys.stderr)
                return stdout, "timeout", runtime
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"[warn] codesage search errored: {exc}", file=sys.stderr)
            return "", "error", runtime
        runtime.update(entries_after=sorted(p.name for p in runtime_path.iterdir()),
                       stderr=stderr, stderr_sha256=hashlib.sha256(stderr.encode()).hexdigest(),
                       returncode=child.returncode)
        if child.returncode != 0:
            print(f"[warn] codesage search failed rc={child.returncode}: {stderr}", file=sys.stderr)
            return stdout, f"rc={child.returncode}", runtime
        try:
            validate_runtime(runtime)
        except InvalidRun as exc:
            print(f"[warn] query runtime: {exc}", file=sys.stderr)
            return stdout, "invalid-runtime", runtime
    if any(message in stderr for message in (
        "cross-encoder rerank failed", "daemon reranking failed", "CODESAGE_ALLOW_CPU_FALLBACK",
    )):
        print(f"[warn] degraded search: {stderr}", file=sys.stderr)
        return stdout, "degraded", runtime
    return stdout, None, runtime


def parse_results(output: str) -> list[tuple[str, str]]:
    """Extract ordered (file_path, chunk_content) pairs, first chunk per file.

    Deduplicates by file_path in rank order so token-budget calculations see
    the chunks an agent would actually consume rank-by-rank.
    """
    lines: list[str] = []
    for line in output.splitlines():
        line = line.strip()
        if line.startswith("[") or line.startswith("{"):
            lines.append(line)
        elif lines:
            lines.append(line)

    json_str = "\n".join(lines)
    if not json_str:
        return []

    try:
        results = json.loads(json_str)
    except json.JSONDecodeError:
        return []
    if isinstance(results, dict):
        results = results.get("results", [])

    seen: set[str] = set()
    ordered: list[tuple[str, str]] = []
    for r in results:
        path = r.get("file_path", "")
        if not path or path in seen:
            continue
        seen.add(path)
        ordered.append((path, r.get("content", "")))
    return ordered


def split_of(case_id: str, salt: str) -> str:
    """Salted held-out assignment; must stay identical to compare-runs.py."""
    digest = hashlib.sha256((salt + "\0" + case_id).encode("utf-8")).digest()
    return "train" if digest[0] < 128 else "heldout"


_SALT_RE = re.compile(r"[A-Za-z0-9_.-]+\Z")


def salt_arg(value: str) -> str:
    # The salt is echoed into the `<!-- METRICS: ... -->` comment; whitespace
    # or `-->` in it would break every consumer that greps that line.
    if not _SALT_RE.match(value):
        raise argparse.ArgumentTypeError(
            f"--salt must match [A-Za-z0-9_.-]+ (got {value!r})"
        )
    return value


def write_results_json(path: Path, meta: dict, results: list[dict], project_root: Path,
                       complete: bool) -> None:
    records = []
    for r in results:
        rec = {
            "id": r["id"],
            "query": r["query"],
            "expected_files": list(r["expected"]),
            "hits": list(r["returned"]),
            "first_hit_rank": r["first_hit_rank"],
            "source": r["source"],
            "repo": str(project_root),
        }
        if r.get("error"):
            rec["error"] = r["error"]
        if "arms" in r:
            rec["arms"] = r["arms"]
        records.append(rec)
    meta = {**meta, "search_failures": sum(1 for r in results if r.get("error"))}
    envelope = {"meta": meta, "complete": complete, "records": records}
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(envelope, indent=2, sort_keys=True) + "\n")
        os.replace(tmp_name, path)
    except BaseException:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def returned_for_case(returned: list[tuple[str, str]], case: dict) -> list[tuple[str, str]]:
    """Drop the case's `defining_file` (self-eval references mode) before ranking.

    The defining file ranks first for a bare-name query and is excluded from
    gold, which would otherwise impose a first-hit floor of 2 on every such
    case. Every case searches at the same `--limit`: over-fetching by one
    changes membership, order and scores of the top rows, so the excluded
    row costs one slot instead and the per-case `returned` column reports
    the resulting length.
    """
    defining = case.get("defining_file")
    if defining:
        returned = [(p, c) for p, c in returned if p != defining]
    return returned


def score_case(
    expected: list[str],
    returned: list[tuple[str, str]],
    k_values: list[int],
) -> dict:
    expected_set = set(expected)
    first_rank = None
    tokens_to_first_hit = 0
    for i, (path, content) in enumerate(returned, start=1):
        tokens_to_first_hit += _count_tokens(content)
        if path in expected_set:
            first_rank = i
            break

    paths_only = [p for p, _ in returned]
    noise_before = (first_rank - 1) if first_rank else len(returned)

    recalls = {}
    for k in k_values:
        topk = set(paths_only[:k])
        hits = len(topk & expected_set)
        recalls[k] = hits / len(expected_set) if expected_set else 0.0

    if first_rank is None:
        tokens_to_first_hit = _MISS_TOKEN_PENALTY

    return {
        "first_hit_rank": first_rank,
        "noise_before_first_hit": noise_before,
        "tokens_to_first_hit": tokens_to_first_hit,
        **{f"recall@{k}": recalls[k] for k in k_values},
        "returned_count": len(returned),
        "mrr": 1.0 / first_rank if first_rank else 0.0,
        "ndcg@10": sum(1 / math.log2(i + 2) for i, p in enumerate(paths_only[:10])
                       if p in expected_set) / sum(
                           1 / math.log2(i + 2) for i in range(min(10, len(expected_set)))
                       ) if expected_set else 0.0,
    }


def format_size(file_count: int, line_count: int) -> str:
    if file_count == 0:
        return "size unknown"
    return f"{file_count:,} files, {line_count:,} LoC"


def format_header(
    *,
    project_root: Path,
    head_sha: str,
    size_str: str,
    corpus_name: str,
    case_count: int,
    limit: int,
    k_values: list[int],
    cs_version: str,
    embedding_model: str,
    embedding_device: str,
    embedding_dim: str,
    reranker: str,
    baseline: str,
    run_ts: str,
    split_str: str = "",
    refs_mode_cases: int = 0,
) -> list[str]:
    """Show unavailable provenance explicitly rather than omitting it."""
    lines: list[str] = []
    lines.append("# CodeSage retrieval scorecard")
    lines.append("")
    lines.append(f"- **Project**: `{project_root}` (HEAD `{head_sha}`, {size_str})")
    case_word = "case" if case_count == 1 else "cases"
    lines.append(f"- **Corpus**: `{corpus_name}` — {case_count} {case_word}{split_str}, "
                 f"top-{limit}, k={k_values}")
    lines.append(f"- **CodeSage**: {cs_version}")
    model_line = f"- **Embedding model**: {embedding_model}"
    if embedding_dim:
        model_line += f" ({embedding_dim}d"
        if embedding_device:
            model_line += f", {embedding_device}"
        model_line += ")"
    elif embedding_device:
        model_line += f" ({embedding_device})"
    lines.append(model_line)
    lines.append(f"- **Reranker**: {reranker}")
    lines.append(f"- **Baseline for comparison**: {baseline}")
    if refs_mode_cases:
        lines.append(
            f"- **Refs-mode adjustment**: each case's `defining_file` is excluded from the returned "
            f"list after the search; the excluded row costs one slot and file de-duplication may cost "
            f"more — the per-case `returned` column is the actual ranked-list length "
            f"({refs_mode_cases}/{case_count} cases affected). Refs-mode scorecards are comparable "
            f"only with other refs-mode runs at the same --limit ({limit})."
        )
    lines.append(f"- **Run at**: {run_ts}")
    lines.append("")
    lines.append("**Measured quantities**: miss rate (no ground-truth file in top-N), "
                 "median first-hit rank, mean recall@5, mean recall@10, mean tokens "
                 "to first relevant hit (cl100k_base, when tiktoken is installed; "
                 "misses are charged a 32k penalty so the average isn't dominated "
                 "by a single un-bounded outlier). Per-case rows show `first_hit_rank`, "
                 "`noise_before_first_hit`, recall@5, recall@10, tokens-to-hit, and the "
                 "ranked list length after any refs-mode exclusion.")
    lines.append("")
    lines.append("**Not measured** (flagged so nothing reads in that we didn't test): "
                 "agent tool-call counts, end-to-end task-completion rate, "
                 "wall-clock vs grep/ripgrep. Add those separately when claiming them.")
    return lines


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("corpus", type=Path)
    ap.add_argument("--limit", type=int, default=10)
    ap.add_argument("--verbose", "-v", action="store_true")
    ap.add_argument("--codesage-bin", default="codesage")
    ap.add_argument("--project-root", type=Path,
                    help="Use another checkout of the same corpus; source/index pins still apply.")
    ap.add_argument(
        "--baseline",
        default=os.environ.get("CODESAGE_BENCH_BASELINE", "placebo+rg"),
        help="Optional historical comparison label. Placebo and rg controls always execute.",
    )
    ap.add_argument("--control-seed", type=int, default=0)
    ap.add_argument("--rg-bin", default="rg")
    ap.add_argument("--reranker-artifact", type=Path, action="append", default=[],
                    help="Pin actual reranker tokenizer and selected ONNX graph bytes (repeat).")
    ap.add_argument(
        "--results-json",
        type=Path,
        default=None,
        help="Write per-case results as JSON (input shape for bench/compare-runs.py).",
    )
    ap.add_argument(
        "--split",
        choices=["train", "heldout"],
        default=None,
        help="Run only the cases in this salted half of the corpus; requires --salt.",
    )
    ap.add_argument("--salt", type=salt_arg, default=None,
                    help="Salt for --split ([A-Za-z0-9_.-]+); record it with the result.")
    ap.add_argument(
        "--allow-search-failures", action="store_true",
        help="Exit 0 even when some `codesage search` calls failed (they still score as misses).",
    )
    args = ap.parse_args()
    if args.limit < 1:
        ap.error("--limit must be >= 1")

    if (args.split is None) != (args.salt is None):
        ap.error("--split and --salt must be given together")

    try:
        corpus_bytes = args.corpus.read_bytes()
    except OSError as e:
        sys.exit(f"cannot read corpus {args.corpus}: {e}")
    corpus_sha256 = hashlib.sha256(corpus_bytes).hexdigest()
    try:
        corpus = yaml.safe_load(corpus_bytes)
    except yaml.YAMLError as e:
        print(f"corpus {args.corpus}: malformed YAML: {e}", file=sys.stderr)
        return 2
    if not isinstance(corpus, dict) or not isinstance(corpus.get("project_root"), str):
        print(f"corpus {args.corpus}: expected a mapping with a string `project_root`",
              file=sys.stderr)
        return 2
    if not isinstance(corpus.get("cases"), list):
        print(f"corpus {args.corpus}: expected a `cases` list", file=sys.stderr)
        return 2
    for i, case in enumerate(corpus["cases"]):
        problem = None
        if not isinstance(case, dict):
            problem = "is not a mapping"
        elif not isinstance(case.get("id"), str):
            problem = "needs a string `id`"
        elif not isinstance(case.get("query"), str):
            problem = "needs a string `query`"
        elif not isinstance(case.get("expected_files"), list) or not case["expected_files"] or not all(
            isinstance(p, str) for p in case["expected_files"]
        ):
            problem = "needs `expected_files` as a non-empty list of strings"
        if problem:
            print(f"corpus {args.corpus}: case #{i} {problem}", file=sys.stderr)
            return 2
    project_root = (args.project_root or Path(corpus["project_root"])).expanduser().resolve()
    k_values = corpus.get("scoring", {}).get("k_values", [5, 10])
    cases = corpus["cases"]
    if args.split is not None:
        total = len(cases)
        cases = [c for c in cases if split_of(str(c["id"]), args.salt) == args.split]
        print(f"[split] {args.split}: {len(cases)} of {total} cases (salt={args.salt!r})",
              file=sys.stderr)
    if not cases:
        why = f" (--split {args.split}, salt {args.salt!r})" if args.split is not None else ""
        print(f"corpus {args.corpus}: no cases to run{why}", file=sys.stderr)
        return 2

    if not project_root.exists():
        sys.exit(f"project_root does not exist: {project_root}")
    if len({c["id"] for c in cases}) != len(cases):
        ap.error("case ids must be unique")

    if args.results_json is not None:
        # Probe before expensive searches without clobbering an existing result.
        try:
            args.results_json.parent.mkdir(parents=True, exist_ok=True)
            fd, probe = tempfile.mkstemp(dir=args.results_json.parent,
                                         prefix=args.results_json.name + ".", suffix=".probe")
            os.close(fd)
            os.unlink(probe)
        except OSError as e:
            sys.exit(f"--results-json {args.results_json} is not writable: {e}")

    try:
        args.codesage_bin = resolve_executable(args.codesage_bin)
        args.rg_bin = resolve_executable(args.rg_bin)
    except (InvalidRun, OSError) as exc:
        print(f"[error] invalid executable identity: {exc}", file=sys.stderr)
        return 3
    cs_info = codesage_version_info(args.codesage_bin, cwd=project_root)
    cs_version = cs_info["version"]
    try:
        context, chunks = capture_context(project_root, args.codesage_bin, args.rg_bin,
                                          args.reranker_artifact)
        missing_gold = {p for c in cases for p in c["expected_files"] if p not in chunks}
        if missing_gold:
            raise InvalidRun(f"gold files outside eligible semantic universe: {sorted(missing_gold)}")
    except (InvalidRun, OSError, ValueError) as e:
        print(f"[error] invalid control provenance: {e}", file=sys.stderr)
        return 3
    head_sha = context["head"]
    file_count, line_count = project_size(project_root)
    size_str = format_size(file_count, line_count)
    cfg = codesage_config(project_root)
    emb_section = cfg.get("embedding", {})
    embedding_model = context.get("model", emb_section.get("model", "unknown"))
    embedding_device = context.get("device", emb_section.get("device", ""))
    reranker = context.get("reranker", emb_section.get("reranker", "none"))
    embedding_dim = emb_section.get("dimensions", "")
    run_ts = now_iso_utc()
    results_meta = {
        "corpus": args.corpus.name,
        "corpus_sha256": corpus_sha256,
        "split": args.split,
        "salt": args.salt,
        "head": head_sha,
        "model": embedding_model,
        "reranker": reranker,
        "codesage": cs_version,
        "build_target": cs_info.get("build_target"),
        "features": cs_info.get("features"),
        "device": cs_info.get("device"),
        "run_at": run_ts,
        "project_root": str(project_root),
        "limit": args.limit,
        "control_protocol": CONTROL_PROTOCOL,
        "control_seed": args.control_seed,
        "provenance": context,
        "runner_sha256": file_pin(Path(__file__))["sha256"],
        "controls_sha256": file_pin(Path(__file__).with_name("_retrieval_controls.py"))["sha256"],
    }
    if args.results_json is not None:
        write_results_json(args.results_json, results_meta, [], project_root, complete=False)

    results = []
    for case in cases:
        cid = case["id"]
        query = case["query"]
        expected = case["expected_files"]
        raw, error, runtime = run_codesage_search(args.codesage_bin, project_root, query, args.limit)
        arms = {}
        try:
            rows = search_rows(raw) if error is None else []
            if any(p not in chunks for p, _ in rows):
                raise InvalidRun("CodeSage returned files outside pinned eligible universe")
            emitted, real_budget = page(rows)
            arm_rows = {"codesage": (emitted, real_budget)}
            arm_rows["placebo"] = page(placebo_rows(chunks, cid, args.control_seed, real_budget["bytes"]), real_budget["bytes"])
            rg_rows, rg_evidence = run_rg(project_root, sorted(chunks), query, args.rg_bin)
            arm_rows["rg"] = page(rg_rows)
            arm_rows["rg_matched"] = page(rg_rows, real_budget["bytes"])
            for name, (emitted_rows, budget) in arm_rows.items():
                ranked = distinct(emitted_rows, case.get("defining_file"))
                arms[name] = {**score_case(expected, ranked, k_values), **budget,
                              "hits": [p for p, _ in ranked]}
            arms["rg"]["evidence"] = rg_evidence
            arms["codesage"]["raw_stdout_sha256"] = hashlib.sha256(raw.encode()).hexdigest()
            arms["codesage"]["raw_stdout_bytes"] = len(raw.encode())
            arms["codesage"]["runtime"] = runtime
            if error:
                arms["codesage"]["error"] = error
            validate_record({"id": cid, "expected_files": expected,
                             "hits": arms["codesage"]["hits"],
                             "first_hit_rank": arms["codesage"]["first_hit_rank"], "arms": arms})
            returned = distinct(emitted, case.get("defining_file"))
        except InvalidRun as exc:
            error = error or f"invalid-control: {exc}"
            returned = []
            print(f"[warn] {cid}: {exc}", file=sys.stderr)
        scored = score_case(expected, returned, k_values)
        scored["id"] = cid
        scored["query"] = query
        scored["error"] = error
        scored["source"] = case.get("source", "?")
        scored["returned"] = [p for p, _ in returned]
        scored["expected"] = expected
        scored["arms"] = arms
        results.append(scored)
        if args.results_json is not None:
            # Full rewrite per case is O(n^2) in bytes by design: crash safety
            # over a few hundred cases costs less than one lost search.
            write_results_json(args.results_json, results_meta, results, project_root,
                               complete=False)
        if args.verbose:
            print(f"[{cid}] first_hit={scored['first_hit_rank']} "
                  f"noise={scored['noise_before_first_hit']} "
                  f"r@5={scored['recall@5']:.2f} r@10={scored['recall@10']:.2f}",
                  file=sys.stderr)
            print(f"  expected: {expected}", file=sys.stderr)
            print(f"  returned[:5]: {returned[:5]}", file=sys.stderr)

    try:
        after, _ = capture_context(project_root, args.codesage_bin, args.rg_bin,
                                    args.reranker_artifact)
        if after != context:
            raise InvalidRun("source/index/config/binary/artifact provenance changed during run")
    except (InvalidRun, OSError, ValueError) as exc:
        print(f"[error] {exc}; saved run remains incomplete", file=sys.stderr)
        return 3

    split_str = f" (split {args.split}, salt {args.salt})" if args.split is not None else ""
    header = format_header(
        split_str=split_str,
        project_root=project_root,
        head_sha=head_sha,
        size_str=size_str,
        corpus_name=args.corpus.name,
        case_count=len(results),
        limit=args.limit,
        k_values=k_values,
        cs_version=cs_version,
        embedding_model=embedding_model,
        embedding_device=embedding_device,
        embedding_dim=embedding_dim,
        reranker=reranker,
        baseline=args.baseline,
        run_ts=run_ts,
        refs_mode_cases=sum(1 for c in cases if c.get("defining_file")),
    )
    for line in header:
        print(line)
    print(f"- **Executed controls**: seeded uniform-file placebo (seed {args.control_seed}), "
          "`rg --sort path` literal query-token OR, and rg at the CodeSage byte budget.")
    print("- **Byte unit**: UTF-8 path + LF + content + LF, all emitted chunks charged; "
          "duplicate files and refs-mode exclusions consume bytes. Final control row may be cut; "
          "a file counts only after its full path header fits.")
    print(f"- **Actual semantic fingerprint**: `{context['semantic_fingerprint']}`")
    print(f"- **Eligible files**: {len(chunks)}, SHA-256 `{context['eligible_files_sha256']}`")
    print("- **Instrument**: current-state retrieval; fresh private inference per query, "
          "with initialization logs and no daemon reuse. Indexing pass mode and "
          "prospective change prediction are not measured.")

    print()
    print("## Per-case results")
    print()
    if _ENCODING is not None:
        print("| id | src | first hit | noise | r@5 | r@10 | tokens→hit | returned |")
        print("|---|---|---:|---:|---:|---:|---:|---:|")
    else:
        print("| id | src | first hit | noise | r@5 | r@10 | returned |")
        print("|---|---|---:|---:|---:|---:|---:|")
    for r in results:
        fh = r["first_hit_rank"] if r["first_hit_rank"] else "MISS"
        line = (
            f"| {r['id']} | {r['source']} | {fh} | {r['noise_before_first_hit']} "
            f"| {r['recall@5']:.2f} | {r['recall@10']:.2f} "
        )
        if _ENCODING is not None:
            ttf = r["tokens_to_first_hit"]
            ttf_str = f"{ttf:,}" if r["first_hit_rank"] else f"MISS ({_MISS_TOKEN_PENALTY:,})"
            line += f"| {ttf_str} "
        print(line + f"| {r['returned_count']} |")

    print("\n## Paired controls\n")
    print("| id | real r@10 | placebo r@10 | rg r@10 | rg matched r@10 | real B | placebo B | rg B | rg matched B |")
    print("|---|---:|---:|---:|---:|---:|---:|---:|---:|")
    for r in results:
        if r.get("error"):
            print(f"| {r['id']} | INVALID | | | | | | | |")
            continue
        arms = r["arms"]
        values = [f"{arms[a]['recall@10']:.3f}" for a in ("codesage", "placebo", "rg", "rg_matched")]
        values += [str(arms[a]["bytes"]) for a in ("codesage", "placebo", "rg", "rg_matched")]
        print("| " + r["id"] + " | " + " | ".join(values) + " |")

    placebo_r10 = rg_r10 = rg_matched_r10 = delta = None
    wins = 0
    if not any(r.get("error") for r in results):
        print("\n| arm | miss rate | median first hit | recall@5 | recall@10 | NDCG@10 | mean B |\n"
              "|---|---:|---:|---:|---:|---:|---:|")
        for name in ("codesage", "placebo", "rg", "rg_matched"):
            arm = [r["arms"][name] for r in results]
            ranks = sorted(r["first_hit_rank"] for r in arm if r["first_hit_rank"])
            print(f"| {name} | {sum(r['first_hit_rank'] is None for r in arm)/len(arm):.3f} "
                  f"| {ranks[len(ranks)//2] if ranks else 'MISS'} "
                  + "".join(f"| {sum(r[k] for r in arm)/len(arm):.4f} " for k in ("recall@5", "recall@10", "ndcg@10", "bytes")) + "|")
        delta = sum(r["arms"]["codesage"]["recall@10"] - r["arms"]["placebo"]["recall@10"] for r in results)/len(results)
        placebo_r10 = sum(r["arms"]["placebo"]["recall@10"] for r in results)/len(results)
        rg_r10 = sum(r["arms"]["rg"]["recall@10"] for r in results)/len(results)
        rg_matched_r10 = sum(r["arms"]["rg_matched"]["recall@10"] for r in results)/len(results)
        wins = sum(r["arms"]["codesage"]["recall@10"] > r["arms"]["placebo"]["recall@10"] for r in results)
        print(f"\nReal minus placebo recall@10: {delta:+.4f}; wins {wins}/{len(results)}. "
              + ("Clears the predeclared majority-of-cases ranking check." if wins > len(results)/2
                 else "Does not clear the majority-of-cases ranking check; no ranking advantage claim."))

    search_failures = sum(1 for r in results if r.get("error"))
    hits = [r for r in results if r["first_hit_rank"] is not None]
    miss_rate = 1.0 - len(hits) / len(results) if results else 0.0
    avg_r5 = sum(r["recall@5"] for r in results) / len(results) if results else 0.0
    avg_r10 = sum(r["recall@10"] for r in results) / len(results) if results else 0.0
    median_first = (
        sorted(r["first_hit_rank"] for r in hits)[len(hits) // 2] if hits else None
    )

    if _ENCODING is not None and results:
        avg_tokens = sum(r["tokens_to_first_hit"] for r in results) / len(results)
    else:
        avg_tokens = None

    print()
    print("## Aggregate")
    if search_failures:
        print(f"- **Search failures:** {search_failures} (scored as misses)")
    print(f"- **Miss rate (no ground-truth file in top-{args.limit}):** {miss_rate:.0%}")
    print(f"- **Median first-hit rank (hits only):** {median_first}")
    print(f"- **Mean recall@5:** {avg_r5:.2f}")
    print(f"- **Mean recall@10:** {avg_r10:.2f}")
    if avg_tokens is not None:
        print(
            f"- **Mean tokens to first relevant hit (cl100k_base, miss penalty {_MISS_TOKEN_PENALTY:,}):** "
            f"{int(round(avg_tokens)):,}"
        )

    print()
    print("## Quotable one-liner")
    pct = f"{int(round((1 - miss_rate) * 100))}%"
    median_str = f"median first-hit rank {median_first}" if median_first is not None else "no hits"
    case_word_q = "case" if len(results) == 1 else "cases"
    invalid = f"[INVALID: {search_failures} search failures] " if search_failures else ""
    print(f"> {invalid}CodeSage {cs_version} hits {pct} of {len(results)} ground-truth {case_word_q}"
          f"{split_str} on `{project_root.name}` (HEAD `{head_sha}`, {size_str}) with "
          f"{embedding_model}"
          + (f" + {reranker}" if reranker and reranker != "none" else "")
          + f", {median_str}, mean recall@10 {avg_r10:.2f}. "
          f"Baseline for comparison: {args.baseline}. "
          + (f"Matched-byte placebo recall@10 {placebo_r10:.2f}, delta {delta:+.2f}, "
             f"wins {wins}/{len(results)}; rg recall@10 {rg_r10:.2f} "
             f"(matched-budget {rg_matched_r10:.2f}). "
             + ("No majority-of-cases ranking advantage. " if wins <= len(results)/2 else "")
             if delta is not None else "Control comparison invalid. ")
          + f"Run {run_ts}.")

    print()
    metrics = (
        f"miss_rate={miss_rate:.4f} "
        f"median_first={median_first if median_first is not None else 'MISS'} "
        f"r5={avg_r5:.4f} r10={avg_r10:.4f} cases={len(results)} "
        f"project={project_root.name} head={head_sha} "
        f"model={embedding_model} reranker={reranker} baseline={args.baseline} "
        f"run_at={run_ts} codesage={cs_info['version_token']}"
    )
    if cs_info.get("build"):
        metrics += f" build={cs_info['build']}"
    if avg_tokens is not None:
        metrics += f" mean_tokens_to_hit={int(round(avg_tokens))}"
    if args.split is not None:
        metrics += f" split={args.split} salt={args.salt}"
    metrics += f" search_failures={search_failures}"
    if delta is not None:
        metrics += (f" placebo_r10={placebo_r10:.4f} rg_r10={rg_r10:.4f} "
                    f"rg_matched_r10={rg_matched_r10:.4f} placebo_delta={delta:.4f} "
                    f"placebo_wins={wins} control_seed={args.control_seed}")
    print(f"<!-- METRICS: {metrics} -->")

    if args.results_json is not None:
        write_results_json(args.results_json, results_meta, results, project_root,
                           complete=True)
        print(f"[results-json] wrote {len(results)} records to {args.results_json}",
              file=sys.stderr)

    if search_failures and not args.allow_search_failures:
        print(f"[error] {search_failures} of {len(results)} searches failed; the scorecard "
              "is not a retrieval result. Fix the index/daemon and rerun, or pass "
              "--allow-search-failures.", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())
