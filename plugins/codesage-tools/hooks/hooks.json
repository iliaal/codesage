{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/brief-hook.sh\"",
            "statusMessage": "CodeSage: load edit context",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
