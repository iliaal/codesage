#!/bin/bash
# codesage-onboard <project-path> [--device gpu|cpu] [--codesage-bin PATH]
#                                 [--no-mcp] [--no-hooks] [--no-hint]
#

set -euo pipefail

usage() {
    cat >&2 <<EOF
usage: codesage-onboard <project-path> [options]

Options:
  --device gpu|cpu        Embedding device (default: gpu)
  --codesage-bin PATH     Path to codesage binary (default: \$PATH lookup)
  --no-mcp                Skip global MCP registration
  --no-hooks              Skip git hook installation
  --no-hint               Skip writing .claude/CLAUDE.md hint file
  --refresh-hint          Overwrite an existing .claude/CLAUDE.md hint
                          (default: skip when present, preserve user edits)
  --hint-only             Only (re)write the agent hint; skip MCP registration,
                          init, indexing, and hooks. Use with --refresh-hint to
                          refresh an already-onboarded repo's hint without a
                          reindex.
  -h, --help              This help
EOF
    exit 2
}

project=""
device="gpu"
codesage_bin=""
skip_mcp=0
skip_hooks=0
skip_hint=0
refresh_hint=0
hint_only=0

while [ $# -gt 0 ]; do
    case "$1" in
        --device)       shift; device="${1:?missing value for --device}" ;;
        --codesage-bin) shift; codesage_bin="${1:?missing value for --codesage-bin}" ;;
        --no-mcp)       skip_mcp=1 ;;
        --no-hooks)     skip_hooks=1 ;;
        --no-hint)      skip_hint=1 ;;
        --refresh-hint) refresh_hint=1 ;;
        --hint-only)    hint_only=1 ;;
        -h|--help)      usage ;;
        --*)            echo "unknown option: $1" >&2; usage ;;
        *)              [ -z "$project" ] && project="$1" || usage ;;
    esac
    shift
done

[ -z "$project" ] && usage

if [ "$device" != "gpu" ] && [ "$device" != "cpu" ]; then
    echo "error: --device must be 'gpu' or 'cpu', got '$device'" >&2
    exit 2
fi

if ! project="$(cd -- "$project" 2>/dev/null && printf '%s/' "$PWD")"; then
    echo "error: project path does not exist or is not a directory: $project" >&2
    exit 1
fi
project="${project%/}"

if [ -z "$codesage_bin" ]; then
    if ! codesage_bin="$(command -v codesage)"; then
        echo "error: 'codesage' not found in \$PATH. Build it (cargo build --release --features cuda -p codesage) and either install it or pass --codesage-bin /path/to/codesage" >&2
        exit 1
    fi
fi
if [ ! -x "$codesage_bin" ]; then
    echo "error: $codesage_bin is not executable" >&2
    exit 1
fi
# Keep the invocation-directory meaning across registration and project subshells.
codesage_bin="$(realpath -- "$codesage_bin")"

name="$(basename "$project")"

echo "==> codesage-onboard"
echo "    project:      $project"
echo "    codesage bin: $codesage_bin"
echo "    device:       $device"
echo

if [ "$hint_only" -eq 1 ]; then
    echo "==> hint-only mode: skipping MCP registration, init, index, and hooks"
else

if [ "$skip_mcp" -eq 0 ]; then
    echo "==> [1/7] global MCP registration"
    if claude mcp list 2>/dev/null | grep -qE '^codesage[[:space:]:]'; then
        echo "    'codesage' already registered, skipping"
    else
        if claude mcp add --scope user codesage -- "$codesage_bin" mcp; then
            echo "    registered: codesage -> $codesage_bin mcp"
        else
            echo "warn: claude mcp add failed — register manually with:" >&2
            echo "  claude mcp add --scope user codesage -- $codesage_bin mcp" >&2
        fi
    fi
else
    echo "==> [1/7] MCP registration skipped (--no-mcp)"
fi

echo "==> [2/7] codesage init"
( cd "$project" && "$codesage_bin" init )

config="$project/.codesage/config.toml"
if [ ! -f "$config" ]; then
    echo "error: $config missing after init" >&2
    exit 1
fi
# init can reuse clone-supplied state; reject links before rewriting config.
if [ -L "$project/.codesage" ] || [ -L "$config" ]; then
    echo "error: $config or its parent is a symlink -- refusing to write through it" >&2
    exit 1
fi

echo "==> [3/7] set device = $device"
python3 - "$config" "$device" <<'PY'
import sys, pathlib, re
path = pathlib.Path(sys.argv[1])
device = sys.argv[2]
text = path.read_text()
new_text, n = re.subn(r'^device\s*=\s*"[^"]*"', f'device = "{device}"', text, count=1, flags=re.MULTILINE)
if n == 0:
    sys.exit(f"could not find `device = \"...\"` line in {path}")
path.write_text(new_text)
PY

echo "==> [4/7] codesage index"
index_log="$(mktemp)"
trap 'rm -f "$index_log"' EXIT

if ( cd "$project" && "$codesage_bin" index ) 2>&1 | tee "$index_log"; then
    :
else
    echo "error: codesage index failed — see output above" >&2
    exit 1
fi

if [ "$device" = "gpu" ]; then
    if grep -qiE '(cuda.*(not|failed|unavailable|disabled))|cpu.*fallback|falling back to cpu' "$index_log"; then
        echo "WARNING: CUDA appears to have fallen back to CPU — check the log above." >&2
        echo "         Embeddings produced on CPU are not bit-identical to CUDA;" >&2
        echo "         this will degrade retrieval quality if the index is mixed." >&2
    fi
fi

if [ "$skip_hooks" -eq 0 ] && [ -e "$project/.git" ]; then
    echo "==> [5/7] installing git hooks"
    ( cd "$project" && "$codesage_bin" install-hooks )
elif [ "$skip_hooks" -eq 0 ]; then
    echo "==> [5/7] not a git repo, skipping hooks"
else
    echo "==> [5/7] hook installation skipped (--no-hooks)"
fi

if [ -e "$project/.git" ]; then
    echo "==> [6/7] indexing git history (V2b)"
    ( cd "$project" && "$codesage_bin" git-index ) || echo "    (git-index failed; find_coupling/assess_risk will return empty)"
else
    echo "==> [6/7] not a git repo, skipping git history index"
fi

fi

# Keep machine-specific hints out of tracked AGENTS.md files.
hint_mode="claude"
hint_file="$project/.claude/CLAUDE.md"
if [ -f "$project/AGENTS.md" ] && [ -e "$project/.git" ]; then
    if git -C "$project" -c core.fsmonitor=false check-ignore -q AGENTS.md 2>/dev/null; then
        hint_mode="agents"
        hint_file="$project/AGENTS.md"
    fi
fi

# Check the parent first: -f would follow a clone-planted directory symlink.
if [ -L "$project/.codesage" ]; then
    echo "error: $project/.codesage is a symlink -- refusing to read project state through it" >&2
    exit 1
fi
if [ -f "$project/.codesage/no-agent-hint" ]; then
    skip_hint=1
fi

if [ "$skip_hint" -eq 0 ]; then
    if [ "$hint_mode" = "claude" ] && [ -f "$hint_file" ] && [ "$refresh_hint" -eq 0 ]; then
        echo "==> [7/7] $hint_file already exists, skipping (pass --refresh-hint to overwrite)"
    else
        case "$hint_mode" in
            agents)
                if grep -q '^<!-- codesage-onboard-hint-begin' "$hint_file" 2>/dev/null; then
                    echo "==> [7/7] updating marked codesage block in $hint_file"
                else
                    echo "==> [7/7] appending marked codesage block to $hint_file"
                fi
                ;;
            claude)
                if [ -f "$hint_file" ]; then
                    echo "==> [7/7] refreshing $hint_file (--refresh-hint)"
                else
                    echo "==> [7/7] writing $hint_file"
                fi
                ;;
        esac

        hint_tmp="$(mktemp)"
        trap 'rm -f "$hint_tmp"' EXIT
        script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
        python3 "${script_dir}/render-guidance.py" --hint "${project}" > "${hint_tmp}"

        case "$hint_mode" in
            agents)
                # Both rewrite and append would follow a clone-planted symlink.
                if [ -L "$hint_file" ]; then
                    echo "error: $hint_file is a symlink -- refusing to write the hint through it" >&2
                    exit 1
                fi
                # A predictable temporary name could be a clone-planted symlink.
                hint_new="$(mktemp "$(dirname "$hint_file")/.codesage-hint.XXXXXX")"
                trap 'rm -f "$hint_new"' EXIT
                if grep -q '^<!-- codesage-onboard-hint-begin' "$hint_file" 2>/dev/null; then
                    awk -v block_file="$hint_tmp" '
                        BEGIN { in_block = 0; injected = 0 }
                        /^<!-- codesage-onboard-hint-begin/ {
                            in_block = 1
                            while ((getline line < block_file) > 0) print line
                            close(block_file)
                            injected = 1
                            next
                        }
                        /^<!-- codesage-onboard-hint-end/ && in_block { in_block = 0; next }
                        in_block { next }
                        { print }
                    ' "$hint_file" > "$hint_new"
                    mv "$hint_new" "$hint_file"
                else
                    if [ -s "$hint_file" ] && [ "$(tail -c 1 "$hint_file" | wc -l)" -eq 0 ]; then
                        printf '\n' >> "$hint_file"
                    fi
                    printf '\n---\n\n' >> "$hint_file"
                    cat "$hint_tmp" >> "$hint_file"
                fi
                ;;
            claude)
                # mkdir and cp follow clone-planted directory symlinks.
                if [ -L "$project/.claude" ]; then
                    echo "error: $project/.claude is a symlink -- refusing to write the hint through it" >&2
                    exit 1
                fi
                mkdir -p "$project/.claude"
                if [ -L "$hint_file" ] || { [ -e "$hint_file" ] && [ ! -f "$hint_file" ]; }; then
                    echo "error: $hint_file is not a regular file -- refusing to write the hint" >&2
                    exit 1
                fi
                cp "$hint_tmp" "$hint_file"
                # Keep the local hint out of the project's commit history.
                if [ -e "$project/.git" ]; then
                    exclude_file="$(git -C "$project" rev-parse --git-path info/exclude 2>/dev/null)"
                    if [ -n "$exclude_file" ]; then
                        case "$exclude_file" in
                            /*) ;;
                            *) exclude_file="$project/$exclude_file" ;;
                        esac
                        mkdir -p "$(dirname "$exclude_file")"
                        if ! grep -qxF ".claude/CLAUDE.md" "$exclude_file" 2>/dev/null; then
                            echo ".claude/CLAUDE.md" >> "$exclude_file"
                            echo "    added to $exclude_file (local-only, not committed)"
                        fi
                    fi
                fi
                ;;
        esac

        rm -f "$hint_tmp"
        trap - EXIT
    fi
else
    if [ -f "$project/.codesage/no-agent-hint" ]; then
        echo "==> [7/7] hint skipped (.codesage/no-agent-hint sentinel present — repo is indexed-only)"
    else
        echo "==> [7/7] hint file skipped (--no-hint)"
    fi
fi

echo
echo "==> verification: codesage doctor"
( cd "$project" && "$codesage_bin" doctor ) || echo "    (one or more checks failed; review above)"

echo
echo "==> done."
echo "    MCP tool calls target this project via: project: \"$project\""
printf '    try it:   cd -- %q && %q search '\''your query'\''\n' "$project" "$codesage_bin"
